# Identify unique cities
cities <- unique(data$CityName)

# Define a function that fits the model for each city
fit_model_for_city <- function(city, data) {
  # Subset the data for the specific city
  city_data <- subset(data, CityName == city)
  
  # Define the model for each city
  model <- parks_percent_change_from_baseline_average ~ 
    Temperature_scaled + Age_scaled + Education_scaled + Income_scaled + 
    GovernmentResponseIndex_scaled + Greenspace_scaled + Rainfall_scaled + 
    f(time_index, model = "rw1") + 
    GovernmentResponseIndex_scaled * Greenspace_scaled
  
  # Fit the model using INLA
  result <- inla(model, data = city_data, family = "gaussian", 
                 control.predictor = list(compute = TRUE), 
                 control.inla = list(verbose = TRUE), 
                 control.compute = list(dic = TRUE, config = TRUE))
  
  return(result)
}

# Apply the function for each city and store the results in a list
results <- lapply(cities, fit_model_for_city, data = data)

# Now, you can access the results for each city from the 'results' list

# For example, to get the result for the first city:
results[[1]]

# Or to get the result for a specific city by name:
results[[which(cities == "CityNameHere")]]



# Extract key statistics (e.g., coefficients and DIC) from each city's result
extract_results <- function(result) {
  # Extract fixed effects (coefficients)
  fixed_effects <- result$summary.fixed[, c("mean", "sd", "0.025quant", "0.975quant")]
  
  # Extract DIC (Deviance Information Criterion)
  dic <- result$dic$dic
  
  # Combine the results into a data frame
  result_summary <- data.frame(fixed_effects, DIC = dic)
  
  return(result_summary)
}

# Apply the function to each city's model results and store in a list
comparison_results <- lapply(results, extract_results)

# Now you have a list of result summaries for each city
# Convert this list into a single data frame for easy comparison
comparison_table <- do.call(rbind, comparison_results)

# Add a column for the city name
comparison_table$City <- rep(cities, each = nrow(comparison_results[[1]]))

